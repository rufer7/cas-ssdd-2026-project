# Copy this file to `.env.local` and fill in the values from your Auth0 dashboard.
# `.env.local` is gitignored so real credentials are never committed.

# Auth0 tenant domain, e.g. dev-abc123.eu.auth0.com
VITE_AUTH0_DOMAIN=

# Client ID of the Auth0 Single Page Application
VITE_AUTH0_CLIENT_ID=

# Identifier (audience) of the Auth0 API the backend validates tokens against.
# Must match AUTH0_AUDIENCE on the backend.
VITE_AUTH0_AUDIENCE=
